FROM rocker/tidyverse:4.3.2

# Install system dependencies required for ggseg and plumber
RUN apt-get update && apt-get install -y \
    libxml2-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libcairo2-dev \
    libudunits2-dev \
    libproj-dev \
    libgdal-dev \
    libgeos-dev \
    libsodium-dev \
    cmake \
    libabsl-dev \
    && rm -rf /var/lib/apt/lists/*

ENV R_REPOS="https://packagemanager.posit.co/cran/__linux__/jammy/latest"

# 3. Instalando library do R
RUN R -e "options(repos = c(CRAN = Sys.getenv('R_REPOS'))); \
    install.packages(c('devtools', 'plumber', 'remotes', 'sf', 'sp', 'maps', 'mapdata', 'maptools', 'rnaturalearth', 'rnaturalearthdata', 'ggrepel', 'svglite'), Ncpus = 1); \
    remotes::install_version('msigdbr', version = '26.1.0', upgrade = 'never'); \
    remotes::install_version('cowplot', version = '1.2.0', upgrade = 'never'); \
    remotes::install_version('vroom', version = '1.7.0', upgrade = 'never')"

# 4. Instalando pacotes do Bioconductor (GSVA)
RUN R -e "options(repos = c(CRAN = Sys.getenv('R_REPOS'))); \
    if (!require('BiocManager', quietly = TRUE)) install.packages('BiocManager'); \
    BiocManager::install(c('GSVA', 'Biobase', 'GSEABase'), update = FALSE, ask = FALSE, Ncpus = 1)"

# 5. Instalando o ggseg fixado na versão 2.1.1
RUN R -e "devtools::install_github('ggsegverse/ggseg.formats')"
RUN R -e "devtools::install_github('ggsegverse/ggseg', ref = 'v2.1.1', upgrade = 'never')"

# Create directory for the API
RUN mkdir -p /api

WORKDIR /api

COPY genes_matrix_csv/ /api/genes_matrix_csv/
COPY mapeamento.R /api/
COPY preparaDados.R /api/

RUN Rscript mapeamento.R && Rscript preparaDados.R

COPY plumber.R /api/

# The port expected by the front-end as per plumber.R
EXPOSE 33857

# Command to start the Plumber API
CMD ["R", "-e", "pr <- plumber::plumb('plumber.R'); pr$run(host = '0.0.0.0', port = 33857, docs = TRUE)"]
